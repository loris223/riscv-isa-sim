{
    "version": "0.2.0",
    "configurations": [
        

      {
        "name": "(gdb) Launch",
        "type": "cppdbg",
        "request": "launch",
        "program": "/opt/RISCV/bin/spike",
        "args": ["--isa=RV32IMAFDC", "pk", "hello"],
        "stopAtEntry": false,
        "cwd": "/opt/tmp",
        "environment": [],
        "externalConsole": false,
        "MIMode": "gdb",
        "setupCommands": [
            {
                "description": "Enable pretty-printing for gdb",
                "text": "-enable-pretty-printing",
                "ignoreFailures": true
            },
            {
                "description": "Set Disassembly Flavor to Intel",
                "text": "-gdb-set disassembly-flavor intel",
                "ignoreFailures": true
            }
        ],
        "preLaunchTask": null,
      }
    ]
  }
  