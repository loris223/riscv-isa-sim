#!/bin/bash

# Exit immediately if any command fails
set -e

# Improved color definitions
RED='\033[0;31m'          # Errors
GREEN='\033[0;32m'        # Success
YELLOW='\033[1;33m'       # Commands/Paths
CYAN='\033[1;36m'         # Info/Headers
MAGENTA='\033[0;35m'      # Special notices
NC='\033[0m'              # No Color

# Initialize variables
RUN_AUTORECONF=false

# Parse command line arguments
while [[ $# -gt 0 ]]; do
    case "$1" in
        --autoreconf)
            RUN_AUTORECONF=true
            shift
            ;;
        *)
            echo -e "${RED}✖ Error: Unknown option $1${NC}"
            echo -e "Usage: $0 [${YELLOW}--autoreconf${NC}]"
            exit 1
            ;;
    esac
done

# Store the original directory
ORIGINAL_DIR=$(pwd)

# Check if RISCV environment variable is set
if [ -z "$RISCV" ]; then
    echo -e "${RED}✖ Error: RISCV environment variable is not set${NC}"
    exit 1
fi

TARGET_DIR="$RISCV/riscv-isa-sim"

# Inform user we're changing directory
echo -e "${CYAN}➔ Changing to ${YELLOW}$TARGET_DIR${NC}"
cd "$TARGET_DIR" || {
    echo -e "${RED}✖ Error: Failed to change to directory $TARGET_DIR${NC}"
    exit 1
}

# Run autoreconf if requested
if $RUN_AUTORECONF; then
    echo -e "${CYAN}➔ Running ${YELLOW}autoreconf --install${NC}"
    autoreconf --install || {
        echo -e "${RED}✖ Error: autoreconf failed${NC}"
        exit 1
    }
fi

# Check for build directory
BUILD_DIR="build"
echo -e "${CYAN}➔ Checking for build directory: ${YELLOW}$BUILD_DIR${NC}"
if [ ! -d "$BUILD_DIR" ]; then
    echo -e "${MAGENTA}ℹ Info: Build directory doesn't exist${NC}"
    echo -e "${RED}✖ Error: Please create it first with: ${YELLOW}mkdir -p $TARGET_DIR/build${NC}"
    exit 1
fi

# Enter build directory
echo -e "${CYAN}➔ Entering build directory${NC}"
cd "$BUILD_DIR" || {
    echo -e "${RED}✖ Error: Failed to enter build directory${NC}"
    exit 1
}

# Configure, make, and install
echo -e "${CYAN}➔ Configuring with prefix=${YELLOW}$RISCV${NC}"
../configure --prefix="$RISCV" || {
    echo -e "${RED}✖ Error: Configuration failed${NC}"
    exit 1
}

echo -e "${CYAN}➔ Running ${YELLOW}make${NC}"
make || {
    echo -e "${RED}✖ Error: Build failed${NC}"
    exit 1
}

echo -e "${CYAN}➔ Running ${YELLOW}make install${NC}"
make install || {
    echo -e "${RED}✖ Error: Installation failed${NC}"
    exit 1
}

# Return to original directory
echo -e "${CYAN}➔ Returning to original directory: ${YELLOW}$ORIGINAL_DIR${NC}"
cd "$ORIGINAL_DIR"

echo -e "\n${GREEN}✓ Installation completed successfully${NC}"
exit 0